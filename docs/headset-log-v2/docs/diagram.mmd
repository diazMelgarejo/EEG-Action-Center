%% Device inventory system: entry, validation, ledger and derived views (PROVISIONAL, private)
flowchart LR
  subgraph Intake
    F["Entry form - named Google account"]
    C["Chat (private) - keyed in by a person, source = chat"]
    T["Ticket - carries Serial, Lab, DefectID"]
  end
  C --> F
  F --> V{"Validator - replay at event time"}
  V -- "all rules pass" --> L[("Ledger - append-only")]
  V -- "rule broken" --> H["Held tab - reason kept, nothing deleted"]
  H --> O["Operator decides"]
  O -->|"correcting row"| F
  L --> G["Day grid"]
  L --> B["Gantt"]
  L --> LG["Legend: Spare 1-4, Under repair 1-3"]
  L --> CS["Current location"]
  L --> R["Reconciliation report"]
  T --> R
  W["Old workbook + legend + chat log - backfill with flags"] --> L
  R -->|"Tickets vs legend: no winner"| O
